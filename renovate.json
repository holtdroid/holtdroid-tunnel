{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":automergeMinor",
    ":automergeBranch",
    "schedule:weekly"
  ],
  "labels": [
    "dependencies"
  ],
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "gradle",
        "gradle-wrapper",
        "gomod"
      ],
      "semanticCommitType": "fix"
    },
    {
      "matchManagers": [
        "github-actions",
        "mise"
      ],
      "semanticCommitType": "ci"
    },
    {
      "description": "Major updates need a human",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "sing-tun, sing and gvisor move together; keep them on the versions one sing-box release uses",
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "github.com/sagernet/**"
      ],
      "groupName": "sing",
      "automerge": false
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "indirect"
      ],
      "enabled": false
    }
  ]
}
